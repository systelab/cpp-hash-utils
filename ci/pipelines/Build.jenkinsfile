def version = '0.0.0'
def profile = 'vs2022.conanprofile'
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']

library identifier: 'cpp-jenkins-pipelines@master', retriever: modernSCM(
  [$class: 'GitSCMSource',
   remote: 'https://github.com/systelab/cpp-jenkins-pipelines.git'])

pipeline
{
	agent
	{
		label 'lib-build'
	}

	parameters
	{
		string(	name: 'version',
				description: 'Version to build (must match the name of the tag that will be checked out), leave as 0.0.0 for checkout of current branch',
				defaultValue: '0.0.0' )

		booleanParam( name: 'uploadPackage',
					  description: 'Whether or not to upload the Conan package',
					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				deleteDir()
				script 
				{
					if (params.version == '0.0.0')
					{
						checkoutSourceCode()
					}
					else
					{
						checkoutSourceCodeFromTag(version)
						version = params.version
					}
				}
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Build ${config}|${arch}")
							{
								def buildFolder = "build-HashUtils-${config}-${arch}"
								bat "conan install . --output-folder ${buildFolder} --profile:all=${profile} --settings:all=build_type=${config} --settings:all=arch=${arch}"
								bat "conan build . --output-folder ${buildFolder} --profile:all=${profile} --settings:all=build_type=${config} --settings:all=arch=${arch}"
								bat "conan export-pkg . --name hash-utils --version ${version} --output-folder ${buildFolder} --profile:all=${profile} --settings:all=build_type=${config} --settings:all=arch=${arch}"
								dir("${buildFolder}/bin/${config}")
								{
									bat "HashUtilsTest.exe --gtest_output=xml:${env.WORKSPACE}/${buildFolder}/test_reports/HashUtilsTest.xml"
								}
								
								def buildFolderTestUtilities = "build-HashUtilsTestUtilities-${config}-${arch}"
								bat "conan install ./test/HashUtilsTestUtilities --version ${version} --output-folder ${buildFolderTestUtilities} --profile:all=${profile} --settings:all=build_type=${config} --settings:all=arch=${arch}"
								bat "conan build ./test/HashUtilsTestUtilities --output-folder ${buildFolderTestUtilities} --profile:all=${profile} --settings:all=build_type=${config} --settings:all=arch=${arch}"
								bat "conan export-pkg ./test/HashUtilsTestUtilities --name hash-utils-test-utilities --version ${version} --output-folder ${buildFolderTestUtilities} --profile:all=${profile} --settings:all=build_type=${config} --settings:all=arch=${arch}"
							}
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{
				bat "conan upload hash-utils/${version} --remote aid-conan-production-local --confirm --force"
				bat "conan upload hash-utils-test-utilities/${version} --remote aid-conan-production-local --confirm --force"
			}
		}	
	}
	
	post
	{
		always
		{
			junit allowEmptyResults: true, testResults: 'build*/test_reports/*.xml'
			script
			{
				currentBuild.description = "${version}"
			}
		}
	}
}